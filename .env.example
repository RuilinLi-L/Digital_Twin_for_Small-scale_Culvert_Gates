# Copy to .env.local for local development. Never commit real connection strings.
# Vercel's Neon integration sets DATABASE_URL in the project environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional direct Neon connection used by npm run db:init.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Only for a local PostgreSQL server outside Vercel:
# HANZHA_DB_SSL=disable
